rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can read photos for the portfolio display
    match /works/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback rules
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
